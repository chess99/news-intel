# news-intel 环境变量配置
# 复制此文件为 .env，填入真实值：
#   cp .env.example .env
# 运行前加载：
#   source .env  （或使用 python-dotenv）

# ── LLM 配置 ────────────────────────────────────────────────────────────────
# LLM_PROVIDER=openai 使用 OpenAI-compatible API。
# LLM_PROVIDER=command 使用本机命令，适合临时交给 Claude Code / Codex / mc。
#
# 本机 agent 示例:
#   LLM_PROVIDER=command
#   LLM_COMMAND=/opt/homebrew/bin/codex -s read-only -a never exec --ephemeral
#   LLM_COMMAND_INPUT=argv
#   LLM_COMMAND_TIMEOUT=120
#
# 如果本机有 mc:
#   LLM_PROVIDER=command
#   LLM_COMMAND=mc --code -p
#   LLM_COMMAND_INPUT=argv
#
# API 示例兼容任何 OpenAI-format API：OpenAI、Together、Groq、本地 Ollama 均可替换
#
# OpenAI:    LLM_API_HOST=https://api.openai.com  LLM_MODEL=gpt-4o
# Groq:      LLM_API_HOST=https://api.groq.com/openai  LLM_MODEL=llama-3.3-70b-versatile
# Ollama:    LLM_API_HOST=http://localhost:11434  LLM_MODEL=qwen2.5:14b

LLM_PROVIDER=openai
LLM_API_HOST=https://api.minimaxi.com
LLM_MODEL=MiniMax-M2.7
LLM_API_KEY=your_openai_compatible_api_key_here
# Legacy MiniMax deployments may still use this variable.
MINIMAX_API_KEY=
LLM_COMMAND=
LLM_COMMAND_INPUT=argv
LLM_COMMAND_TIMEOUT=120

# ── 代理配置 ─────────────────────────────────────────────────────────────────
# 中国大陆用户通常需要代理访问 GitHub、TechCrunch 等境外信源
# 海外用户无需代理，留空即可
# 格式: http://host:port 或 socks5://host:port

HTTPS_PROXY=
# HTTPS_PROXY=http://127.0.0.1:7890

# ── 飞书推送配置 ─────────────────────────────────────────────────────────────
# 只在运行 deliver 阶段或完整 pipeline 且未使用 --skip-delivery 时需要。

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=
