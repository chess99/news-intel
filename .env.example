# news-intel 环境变量配置
# 复制此文件为 .env，填入真实值：
#   cp .env.example .env
# 运行前加载：
#   source .env  （或使用 python-dotenv）

# ── LLM API 配置 ────────────────────────────────────────────────────────────
# 默认使用 MiniMax M2.7 (https://api.minimaxi.com)
# 兼容任何 OpenAI-format API：OpenAI、Together、Groq、本地 Ollama 均可替换
#
# OpenAI:    LLM_API_HOST=https://api.openai.com  LLM_MODEL=gpt-4o
# Groq:      LLM_API_HOST=https://api.groq.com/openai  LLM_MODEL=llama-3.3-70b-versatile
# Ollama:    LLM_API_HOST=http://localhost:11434  LLM_MODEL=qwen2.5:14b

LLM_API_HOST=https://api.minimaxi.com
LLM_MODEL=MiniMax-M2.7
MINIMAX_API_KEY=your_minimax_api_key_here

# ── 代理配置 ─────────────────────────────────────────────────────────────────
# 中国大陆用户通常需要代理访问 GitHub、TechCrunch 等境外信源
# 海外用户无需代理，留空即可
# 格式: http://host:port 或 socks5://host:port

HTTPS_PROXY=
# HTTPS_PROXY=http://127.0.0.1:7890
